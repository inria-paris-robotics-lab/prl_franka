<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="prl_franka">

  <xacro:include filename="$(find franka_description)/robots/common/franka_robot.xacro"/>
  <xacro:include filename="$(find prl_franka_description)/urdf/cameras/_fixed_cameras.urdf.xacro"/>


  <xacro:arg name="robot_config_file" default="$(find prl_franka_configuration)/config/robot_config.yaml"/>
  <xacro:property name="setup" value="${xacro.load_yaml('$(arg robot_config_file)')}"/>
  <xacro:property name="arm_id" value="${setup['ROBOT']['arm_id']}"/>
  <xacro:property name="robot_ip" value="${setup['ROBOT']['robot_ip']}"/>
  <xacro:property name="prefix" value="${setup['ROBOT']['arm_prefix']}"/>
  <xacro:property name="load_end_effector" value="${setup['ROBOT']['load_end_effector']}"/>
  <xacro:property name="ee_id" value="${setup['ROBOT']['ee_id']}"/>
  <xacro:property name="hand" value="${setup['ROBOT']['load_end_effector']}"/>
  <xacro:property name="with_sc" value="${setup['ROBOT']['self_collision_safety']}"/>
  <xacro:property name="arm_pose" value="${setup['ROBOT']['arm_pose']}"/>
  <xacro:property name="xyz_arm" value="${' '.join(map(str, arm_pose['xyz']))}"/>
  <xacro:property name="rpy_arm" value="${' '.join(map(str, arm_pose['rpy']))}"/>
  <xacro:property name="ee_pose" value="${setup['ROBOT']['end_effector_pose']}"/>
  <xacro:property name="xyz_ee" value="${' '.join(map(str, ee_pose['xyz']))}"/>
  <xacro:property name="rpy_ee" value="${' '.join(map(str, ee_pose['rpy']))}"/>
  <xacro:property name="ft_sensor" value="${setup['ROBOT']['use_ft_sensor']}"/>
  <xacro:property name="load_ee" value="${str(load_end_effector).lower() == 'true'}"/>
  <xacro:property name="with_sc_bool" value="${str(with_sc).lower() == 'true'}"/>
  <xacro:property name="cameras_setup_file" value="${setup['fixed_cameras_file']}"/>


  <!-- Multi-arm setup? -->
  <xacro:arg name="multi_arm" default="false" />

  <!-- Don't print a prefix for joints, visuals, and links? -->
  <xacro:arg name="no_prefix" default="false"/>

  <!-- Position offset between ee frame and tcp frame -->
  <xacro:arg name="tcp_xyz" default="0 0 0.1034" />

  <!-- Rotation offset between ee frame and tcp frame -->
  <xacro:arg name="tcp_rpy" default="0 0 0" />

  <!-- Safety distance for the collision capsules -->
  <xacro:arg name="safety_distance" default="0.03" />

  <!-- Is the robot being controlled with ros2_control?" -->
  <xacro:arg name="ros2_control" default="false" />

  <!-- Should a fake hardware be used? -->
  <xacro:arg name="use_fake_hardware" default="false" />

  <!-- Should fake sensors be used? -->
  <xacro:arg name="fake_sensor_commands" default="false" />

  <!-- Should the robot be spawned in Gazebo?" -->
  <xacro:arg name="gazebo" default="false" />

  <!-- Should the robot be spawned in Gazebo with effort interfaces?" -->
  <xacro:arg name="gazebo_effort" default="false" />

  <!-- Name of the description package -->
  <xacro:arg name="description_pkg" default="franka_description" />

  <!-- Append an underscore to the user-provided prefix, if non-empty. -->
  <xacro:property name="modified_prefix" value="${prefix + '_' if prefix else ''}"/>

  <xacro:arg name="use_ft_sensor" default="false"/>


  <!-- Include table-->
  <link name="base_link" />
  <joint name="base_to_table" type="fixed">
    <parent link="base_link"/>
    <child link="table_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <material name="blue">
    <color rgba="${20/255} ${100/255} ${230/255} 1.0"/>
  </material>

  <xacro:arg name="table_scale" default="1 1 1"/>

  <link name="table_link">
      <visual>
          <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
          <geometry>
              <mesh filename="package://prl_franka_description/meshes/table.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="blue"/>
      </visual>
      <collision>
          <origin xyz="0 0 0.3674" rpy="0 0 ${pi/2}"/>
          <geometry>
              <box size="1.384 1.114 0.7348"/>
          </geometry>
      </collision>
      <inertial>
          <mass value="10.0"/>
          <origin xyz="0 0 -0.050" rpy="0 0 0"/>
          <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
      </inertial>
  </link>

  <link name="table_center"/>
  <joint name="table_center_joint" type="fixed">
    <parent link="table_link"/>
    <child link="table_center"/>
    <origin xyz="0 0 0.7348" rpy="0 0 0"/>
  </joint>

  <joint name="${arm_id}_attachment_joint" type="fixed">
    <parent link="table_center"/>
    <child link="${arm_id}_attachment_link"/>
    <origin xyz="${xyz_arm}" rpy="${rpy_arm}"/>
  </joint>

  <!-- Force torque sensor -->
  <xacro:if value="${ft_sensor}">
    <xacro:include filename="$(find robotiq_ft_sensor_description)/urdf/robotiq_ft300.urdf.xacro" />
    <xacro:robotiq_ft300 parent="${modified_prefix}${arm_id}_link8" tf_prefix="${modified_prefix}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:robotiq_ft300>
    <!-- args -->
    <xacro:arg name="use_fake_mode" default="false"/>
    <xacro:arg name="max_retries" default="100"/>
    <xacro:arg name="read_rate" default="100"/>
    <xacro:arg name="ftdi_id" default=""/>
    <!-- robotiq sensor hardware -->
    <xacro:if value="$(arg ros2_control)">
      <xacro:if value="$(arg use_ft_sensor)">
        <xacro:include filename="$(find robotiq_ft_sensor_description)/urdf/robotiq_fts.ros2_control.xacro" />
        <xacro:robotiq_fts_ros2_control
            tf_prefix="${modified_prefix}"
            use_fake_mode="$(arg use_fake_mode)"
            max_retries="$(arg max_retries)"
            read_rate="$(arg read_rate)"
            ftdi_id="$(arg ftdi_id)"
        />
      </xacro:if>
    </xacro:if>
    <xacro:property name="ee_mount_parent" value="${modified_prefix}robotiq_ft_frame_id"/>
    <xacro:property name="special_connection" value="robotiq_ft_frame_id"/>
  </xacro:if>
  <xacro:unless value="${ft_sensor}">
    <xacro:property name="ee_mount_parent" value="${modified_prefix}${arm_id}_link8"/>
    <xacro:property name="special_connection" value=""/>
  </xacro:unless>

  <!-- Arm geometry (franka_description >= 2.x: geometry only, no ros2_control/gazebo) -->
  <xacro:franka_robot
      robot_type="${arm_id}"
      hand="${load_ee and ee_id != 'ball'}"
      ee_id="${ee_id if ee_id != 'ball' else 'none'}"
      special_connection="${special_connection}"
      xyz_ee="${xyz_ee}"
      rpy_ee="${rpy_ee}"
      tcp_xyz="$(arg tcp_xyz)"
      tcp_rpy="$(arg tcp_rpy)"
      safety_distance="$(arg safety_distance)"
      include_self_collision_geometry="${'$(arg gazebo)' != 'true'}"
      with_sc="${with_sc_bool}"
      no_prefix="$(arg no_prefix)"
      arm_prefix="${modified_prefix}"
      description_pkg="$(arg description_pkg)"
      connected_to="${arm_id}_attachment_link"
      xyz="0 0 0"
      rpy="0 0 0"/>

  <xacro:if value="${ee_id == 'ball' and load_ee}">
    <xacro:include filename="$(find prl_franka_description)/urdf/end_effectors/ball/ball.urdf.xacro"/>
    <xacro:ball_effector
        parent="${ee_mount_parent}"
        prefix="${modified_prefix}${arm_id}"
        xyz_ee="${xyz_ee}"
        rpy_ee="${rpy_ee}"
        tcp_xyz="$(arg tcp_xyz)"
        tcp_rpy="$(arg tcp_rpy)"/>
  </xacro:if>

  <!-- ros2_control: real / mock hardware (franka_hardware) -->
  <xacro:if value="${'$(arg ros2_control)' == 'true' and '$(arg gazebo)' != 'true'}">
    <xacro:include filename="$(find franka_hardware)/ros2_control/franka_arm.ros2_control.xacro"/>
    <xacro:include filename="$(find franka_hardware)/ros2_control/franka_arm_hardware_plugins.xacro"/>
    <xacro:franka_arm_ros2_control
        robot_type="${arm_id}"
        include_effort_command="true"
        include_finger_joint="false"
        arm_prefix="${modified_prefix}">
      <hardware_plugin>
        <xacro:if value="$(arg use_fake_hardware)">
          <xacro:franka_mock_hardware_plugin fake_sensor_commands="$(arg fake_sensor_commands)"/>
        </xacro:if>
        <xacro:unless value="$(arg use_fake_hardware)">
          <xacro:franka_real_hardware_plugin robot_ip="${robot_ip}" arm_prefix="${modified_prefix}"/>
        </xacro:unless>
      </hardware_plugin>
    </xacro:franka_arm_ros2_control>
  </xacro:if>

  <!-- ros2_control: Gazebo (franka_gazebo_bringup) -->
  <xacro:if value="$(arg gazebo)">
    <xacro:include filename="$(find franka_hardware)/ros2_control/franka_arm.ros2_control.xacro"/>
    <xacro:include filename="$(find franka_gazebo_bringup)/urdf/franka_gazebo_hardware_plugins.xacro"/>
    <xacro:include filename="$(find franka_gazebo_bringup)/urdf/franka_gazebo_transmissions.xacro"/>
    <xacro:franka_gazebo_transmissions
        robot_type="${arm_id}"
        arm_prefix="${modified_prefix}"
        ee_id="${ee_id}"
        hand="${load_ee and ee_id == 'franka_hand'}"/>
    <xacro:franka_arm_ros2_control
        robot_type="${arm_id}"
        include_effort_command="$(arg gazebo_effort)"
        include_finger_joint="${load_ee and ee_id == 'franka_hand'}"
        arm_prefix="${modified_prefix}">
      <hardware_plugin>
        <xacro:franka_gazebo_hardware_plugin gazebo_effort="$(arg gazebo_effort)"/>
      </hardware_plugin>
    </xacro:franka_arm_ros2_control>
    <xacro:franka_gazebo_ros2_control_system/>
  </xacro:if>


  <!-- Cameras fixed around the table-->

  <!-- Turn on the simulated camera streams (Gazebo) -->
  <xacro:arg name="activate_cameras" default="false"/>
  <!-- same `activate` flags as the real drivers (prl_franka_control/sensors.launch.py) -->
  <xacro:property name="cameras_config" value="${xacro.load_yaml('$(find prl_franka_configuration)/config/fixed_cameras/cameras_config.yaml')['cameras']}"/>
  <xacro:property name="active_cameras" value="${[n for n, c in cameras_config.items() if c.get('activate', False)] if '$(arg activate_cameras)' == 'true' else []}"/>
  <xacro:if value="${cameras_setup_file is not None}">
    <xacro:fixed_cameras parent="table_center" fixed_cameras_file="$(find prl_franka_configuration)/config/${cameras_setup_file}" active_cameras="${active_cameras}"/>
  </xacro:if>
</robot>
